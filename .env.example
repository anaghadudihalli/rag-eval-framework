# LLM Provider: 'openai' (default, paid) or 'groq' (free tier)
# Groq free tier: 14,400 req/day, no credit card — https://console.groq.com
LLM_PROVIDER=openai

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...your-key-here...
JUDGE_MODEL=gpt-3.5-turbo

# Groq (used when LLM_PROVIDER=groq) — free tier
# GROQ_API_KEY=gsk_...your-groq-key-here...
# GROQ_MODEL=llama-3.1-8b-instant

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=rag-eval-docs
VECTOR_STORE_BACKEND=opensearch
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=5
CONFIDENCE_THRESHOLD=0.7
SIMILARITY_THRESHOLD=0.75
HALLUCINATION_THRESHOLD=0.5
